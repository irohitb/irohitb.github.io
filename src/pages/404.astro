---
import Base from "../layouts/Base.astro";
import Background from "../components/Background.astro";
import Nav from "../components/Nav.astro";
import { profile } from "../data/profile";

// Served by GitHub Pages for any unmatched path (Astro emits this as 404.html).
const links = [
  { href: "/", label: "Home", note: "the whole story, one page" },
  { href: "/experience", label: "Experience", note: "roles, in detail" },
  { href: "/recommendations", label: "Recommendations", note: "what people I worked with said" },
  { href: profile.resumeUrl, label: "Résumé", note: "PDF" },
];
---

<Base title="Rohit Bhatia — Page not found">
  <div style="position:relative; min-height:100vh;">
    <Background />
    <Nav subpage />

    <div class="nf" style="position:relative; z-index:1;">
      <div class="nf-tag">
        <span style="color:var(--faint);">&lt;/</span><span style="color:var(--accent);">404</span
        ><span style="color:var(--faint);">&gt;</span>
      </div>

      <h1>This page doesn&rsquo;t exist.</h1>
      <p class="nf-lede">
        Either I moved it, or the link that sent you here was wrong. Both are my fault more often
        than not.
      </p>

      <p class="nf-path" id="nf-path" hidden>
        <span style="color:var(--muted);">requested</span> <code id="nf-path-value"></code>
      </p>

      <div class="nf-links">
        {
          links.map((l) => (
            <a href={l.href} class="nf-link">
              <span class="nf-link-label">{l.label}</span>
              <span class="nf-link-note">{l.note}</span>
            </a>
          ))
        }
      </div>

      <p class="nf-foot">
        Think something should be here? Tell me &mdash;{" "}
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
    </div>
  </div>

  <script is:inline>
    // Show the path that missed — useful when a link elsewhere is broken.
    (function () {
      try {
        var p = window.location.pathname;
        if (!p || p === "/") return;
        document.getElementById("nf-path-value").textContent = p;
        document.getElementById("nf-path").hidden = false;
      } catch (e) {}
    })();
  </script>
</Base>

<style>
  .nf {
    max-width: 640px;
    margin: 0 auto;
    padding: 96px 24px 96px;
  }
  @media (max-width: 640px) {
    .nf {
      padding-top: 56px;
    }
  }
  .nf-tag {
    font-family: "Geist Mono", monospace;
    font-size: 15px;
    margin-bottom: 20px;
  }
  .nf h1 {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text1);
    margin: 0 0 12px;
  }
  .nf-lede {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-c8);
    margin: 0 0 20px;
    max-width: 48ch;
  }
  .nf-path {
    font-size: 11.5px;
    font-family: "Geist Mono", monospace;
    margin: 0 0 36px;
  }
  .nf-path code {
    color: var(--text-e4);
    border: 1px solid var(--border-12);
    border-radius: 4px;
    padding: 2px 6px;
    word-break: break-all;
  }

  .nf-links {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-12);
  }
  .nf-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 2px;
    border-bottom: 1px solid var(--border-12);
    transition: padding-left 0.15s ease;
  }
  .nf-link:hover {
    padding-left: 8px;
  }
  .nf-link-label {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--text-e4);
  }
  .nf-link:hover .nf-link-label {
    color: var(--accent);
  }
  .nf-link-note {
    font-family: "Geist Mono", monospace;
    font-size: 11px;
    color: var(--muted);
    text-align: right;
  }

  .nf-foot {
    margin: 36px 0 0;
    font-size: 13px;
    color: var(--muted2);
  }
  .nf-foot a {
    color: var(--text-9);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
